<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InvestmentResearch.Views.WatchlistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:InvestmentResearch.ViewModels"
    xmlns:helpers="using:InvestmentResearch.Helpers">

    <Grid Padding="32,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Watchlist" Style="{StaticResource TitleTextBlockStyle}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <TextBox
                Width="240"
                PlaceholderText="Add symbol, e.g. AAPL"
                CharacterCasing="Upper"
                Text="{x:Bind ViewModel.NewSymbol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                KeyDown="NewSymbol_KeyDown" />
            <Button Content="Add" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.AddCommand}" />
            <Button Command="{x:Bind ViewModel.RefreshCommand}" ToolTipService.ToolTip="Refresh quotes">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Refresh" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
            <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="8">
            <InfoBar
                Severity="Informational"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.IsUsingSampleData}"
                Title="Sample data"
                Message="Prices are simulated. Add a free Alpha Vantage API key in Settings to get real market data." />
            <InfoBar
                Severity="Error"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
        </StackPanel>

        <ListView
            Grid.Row="3"
            ItemsSource="{x:Bind ViewModel.Items}"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="Watchlist_ItemClick">
            <ListView.Header>
                <Grid Padding="16,0,16,8" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Symbol" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="Last" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="Change" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="Volume" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                </Grid>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:WatchlistItemViewModel">
                    <Grid Padding="0,10" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Symbol}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{x:Bind PriceText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock
                            Grid.Column="2"
                            Text="{x:Bind ChangeText, Mode=OneWay}"
                            Foreground="{x:Bind helpers:Format.ChangeBrush(IsUp), Mode=OneWay}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{x:Bind VolumeText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <Button
                            Grid.Column="4"
                            HorizontalAlignment="Right"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTipService.ToolTip="Remove from watchlist"
                            Click="RemoveButton_Click">
                            <SymbolIcon Symbol="Delete" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
