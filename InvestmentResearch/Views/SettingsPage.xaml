<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InvestmentResearch.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Padding="32,24" Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
        <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

        <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel Spacing="12">
                <TextBlock Text="Market data" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock TextWrapping="Wrap">
                    <Run Text="Live quotes, history and fundamentals come from Alpha Vantage. Their free API key allows 25 requests per day." />
                    <Hyperlink NavigateUri="https://www.alphavantage.co/support/#api-key">Get a free API key</Hyperlink>
                </TextBlock>
                <PasswordBox
                    Header="Alpha Vantage API key"
                    PlaceholderText="Leave empty to use sample data"
                    Password="{x:Bind ViewModel.ApiKey, Mode=TwoWay}" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveCommand}" />
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel Spacing="4">
                <TextBlock Text="Storage" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="Settings and watchlist are saved to:" />
                <TextBlock Text="{x:Bind ViewModel.SettingsFilePath}" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
